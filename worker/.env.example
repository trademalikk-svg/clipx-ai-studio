# Copy these names into the trusted worker host's secret/config settings.
# Never commit real values or put them in GitHub Pages/browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Processing stays off until a host and its spending limit are approved.
CLIPX_CLOUD_PROCESSING_ENABLED=false
# Required when cloud processing is explicitly enabled; conservative per-job maximum in INR paise.
# Leave blank until host pricing and a per-job cost estimate are verified.
CLIPX_CLOUD_JOB_RESERVE_PAISE=
SUPABASE_BUCKET=clipx-private
POLL_MS=8000
CLIP_SECONDS=30

# Conservative operational quotas (not a currency billing meter).
MAX_INPUT_BYTES=2147483648
MAX_CLIPS_PER_JOB=10
MAX_JOBS_PER_USER_PER_DAY=2
MAX_JOBS_GLOBAL_PER_MONTH=25

# Paid AI calls are hard-disabled until a provider and explicit spend cap are configured.
CLIPX_AI_HIGHLIGHTS_ENABLED=false
CLIPX_VIDEO_GENERATION_ENABLED=false
MAX_AI_SPEND_USD=0
